{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tideventure-site",
  "main": "src/index.js",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Off deliberately. The *.workers.dev hostname is not covered by the
  // Cloudflare Access policy that protects tideventurecpa.com/admin, so leaving
  // it on serves the admin panel with one layer of defence missing. The custom
  // routes below are the only intended way in.
  "workers_dev": false,
  "routes": [
    { "pattern": "portal.tideventurecpa.com/*", "zone_name": "tideventurecpa.com" },
    { "pattern": "tideventurecpa.com/portal*", "zone_name": "tideventurecpa.com" },
    { "pattern": "tideventurecpa.com/admin*", "zone_name": "tideventurecpa.com" },
    { "pattern": "tideventurecpa.com/*", "zone_name": "tideventurecpa.com" }
  ],
  "r2_buckets": [
    {
      "bucket_name": "tideventure-documents",
      "binding": "tideventure_documents"
    },
    {
      "bucket_name": "tideventure-backups",
      "binding": "tideventure_backups"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tideventure-db",
      "database_id": "308156a2-19ed-4016-a35a-df11e83f82e6"
    }
  ],
  "triggers": {
    "crons": ["0 12 * * *"]
  }
}
